# pnpm 严格模式：只提升项目显式声明的依赖，避免幽灵依赖
strict-peer-dependencies=true
# 只允许安装 package.json 中声明的包，拒绝依赖提升后可用的隐式依赖
inject-workspace-packages=true
# 使用 registry.npmmirror.com 可提升国内网络访问速度（按需保留或替换）
# registry=https://registry.npmmirror.com
# 自动安装 peer dependencies（tsc 类型等）
auto-install-peers=true
# 安装时冻结 lockfile，保证可复现构建
frozen-lockfile=false
