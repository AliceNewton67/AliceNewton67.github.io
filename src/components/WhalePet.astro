---
// DS 鲸鱼娘「溟月」看板娘。
// 模型素材：CC BY-NC-SA 4.0（上善无形 / ZipZipPipe / 氵六青），
// 见 /credits/ 与 /live2d/ds-whale-girl/LICENSE。
// 渲染器：PIXI.js 6 + pixi-live2d-display 0.4（Cubism 4），全部自托管。
---

<div class="whale-pet" id="whale-pet">
  <button class="whale-pet-hide" type="button" aria-label="收起看板娘" title="收起看板娘">
    ×
  </button>

  <div class="whale-pet-stage" id="whale-pet-stage">
    <canvas id="whale-pet-canvas" aria-hidden="true"></canvas>
    <p class="whale-pet-bubble" id="whale-pet-bubble" role="status"></p>
  </div>

  <p class="whale-pet-credit">
    <a
      href="/credits/"
      title="看板娘素材署名与许可：上善无形 / ZipZipPipe / 氵六青，CC BY-NC-SA 4.0"
    >
      <span class="whale-pet-credit-full">
        溟月 · 上善无形 / ZipZipPipe / 氵六青<br />
        <span>CC BY-NC-SA 4.0</span>
      </span>
      <span class="whale-pet-credit-short">溟月 · CC BY-NC-SA 4.0</span>
    </a>
  </p>

  <p class="sr-only">
    页面右下角有一只 DeepSeek 鲸鱼娘看板娘，会跟着鼠标转头；点击她会挤番茄酱。
  </p>
</div>

<button class="whale-pet-boot" id="whale-pet-boot" type="button" aria-live="polite">
  鲸鱼娘正在游过来…
</button>

<button class="whale-pet-return" type="button" aria-label="唤回看板娘" title="唤回看板娘">
  鲸
</button>

<noscript>
  <style>
    .whale-pet-boot,
    .whale-pet-return {
      display: none !important;
    }
  </style>
</noscript>

<script is:inline>
  (() => {
    const KEY = 'ecliptic-whale';
    const root = document.documentElement;
    const pet = document.getElementById('whale-pet');
    const stage = document.getElementById('whale-pet-stage');
    const canvas = document.getElementById('whale-pet-canvas');
    const bubble = document.getElementById('whale-pet-bubble');
    const boot = document.getElementById('whale-pet-boot');
    const hideButton = pet.querySelector('.whale-pet-hide');
    const returnButton = document.querySelector('.whale-pet-return');

    let app = null;
    let model = null;
    let starting = false;
    let bubbleTimer = 0;
    let slowHint = 0;
    const focus = { x: 0, y: 0, queued: false };

    const isHidden = () => root.classList.contains('whale-hidden');
    const isSmall = () => window.matchMedia('(max-width: 640px)').matches;

    function setBoot(text, mode) {
      clearTimeout(slowHint);
      boot.textContent = text;
      boot.dataset.mode = mode;
      boot.hidden = false;
    }

    function hideBoot() {
      clearTimeout(slowHint);
      boot.hidden = true;
    }

    function say(text, duration = 4200) {
      bubble.textContent = text;
      bubble.dataset.show = 'true';
      clearTimeout(bubbleTimer);
      bubbleTimer = window.setTimeout(() => {
        bubble.dataset.show = 'false';
      }, duration);
    }

    function setHidden(hidden) {
      root.classList.toggle('whale-hidden', hidden);
      try {
        localStorage.setItem(KEY, hidden ? 'hidden' : 'shown');
      } catch {}
      if (hidden) {
        hideBoot();
        if (app) app.ticker.stop();
      } else {
        if (app) {
          app.ticker.start();
          hideBoot();
        } else {
          setBoot('鲸鱼娘正在游过来…', 'loading');
          ensureModel();
        }
      }
    }

    hideButton.addEventListener('click', () => setHidden(true));
    returnButton.addEventListener('click', () => setHidden(false));
    boot.addEventListener('click', () => {
      if (boot.dataset.mode === 'error') {
        window.location.reload();
        return;
      }
      if (boot.dataset.mode === 'idle') ensureModel();
    });

    function loadScript(src) {
      return new Promise((resolve, reject) => {
        if (document.querySelector(`script[data-whale-src="${src}"]`)) {
          resolve();
          return;
        }
        const script = document.createElement('script');
        script.src = src;
        script.async = false;
        script.dataset.whaleSrc = src;
        script.onload = () => resolve();
        script.onerror = () => reject(new Error('failed to load ' + src));
        document.head.appendChild(script);
      });
    }

    function fail(error) {
      const message = String(error && error.message ? error.message : error).slice(0, 200);
      console.error('[whale-pet]', error);
      starting = false;
      root.dataset.whale = 'error';
      root.dataset.whaleError = message;
      setBoot('她卡住了，点我重试', 'error');
      boot.title = message;
    }

    async function ensureModel() {
      if (starting || isHidden()) return;
      starting = true;
      setBoot('鲸鱼娘正在游过来…', 'loading');
      slowHint = window.setTimeout(() => {
        if (starting && !isHidden()) boot.textContent = '还在游…首次约 5 MB';
      }, 12000);
      try {
        await Promise.race([
          (async () => {
            await loadScript('/live2d/vendor/pixi.min.js');
            await loadScript('/live2d/vendor/live2dcubismcore.min.js');
            await loadScript('/live2d/vendor/cubism4.min.js');
            await bootModel();
          })(),
          new Promise((_, reject) => {
            window.setTimeout(() => reject(new Error('加载超时（120 秒）')), 120000);
          }),
        ]);
      } catch (error) {
        fail(error);
      }
    }

    async function bootModel() {
      if (!window.PIXI || !window.PIXI.live2d) throw new Error('Live2D renderer missing');

      const width = stage.clientWidth || 258;
      const height = stage.clientHeight || 336;
      app = new PIXI.Application({
        view: canvas,
        width,
        height,
        transparent: true,
        antialias: true,
        autoDensity: true,
        resolution: Math.min(window.devicePixelRatio || 1, 2),
        backgroundAlpha: 0,
      });

      model = await Promise.race([
        PIXI.live2d.Live2DModel.from('/live2d/ds-whale-girl/c_0120.model3.json', {
          autoInteract: true,
          autoUpdate: true,
        }),
        new Promise((_, reject) => {
          window.setTimeout(() => reject(new Error('模型加载超时（90 秒）')), 90000);
        }),
      ]);
      app.stage.addChild(model);

      const layout = () => {
        const w = stage.clientWidth;
        const h = stage.clientHeight;
        if (!w || !h) return;
        app.renderer.resize(w, h);
        const naturalWidth = model.width || 2048;
        const naturalHeight = model.height || 2048;
        const scale = Math.min(w / naturalWidth, h / naturalHeight);
        model.scale.set(scale);
        model.anchor.set(0.5, 1);
        model.position.set(w / 2, h);
      };

      layout();
      window.addEventListener('resize', layout, { passive: true });

      // 现成的吃饭道具：左手「蛋包饭」，点击时挤番茄酱。
      model.expression('蛋包饭').catch(() => {});

      pet.dataset.ready = 'true';
      root.dataset.whale = 'ready';
      hideBoot();
      say('今天也想来一碗白米饭…', 5200);

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced) {
        const onPointerMove = (event) => {
          if (app && !app.ticker.started) return;
          const rect = canvas.getBoundingClientRect();
          focus.x = event.clientX - rect.left;
          focus.y = event.clientY - rect.top;
          if (focus.queued) return;
          focus.queued = true;
          requestAnimationFrame(() => {
            focus.queued = false;
            if (model) model.focus(focus.x, focus.y);
          });
        };
        window.addEventListener('pointermove', onPointerMove, { passive: true });
      }

      canvas.addEventListener('click', eat);
    }

    async function eat() {
      if (!model) return;
      say('番茄酱要挤成小鲸鱼哦~', 3600);
      try {
        await model.expression('蛋包饭');
        await model.motion('Ketchup');
        await model.expression('挤番茄酱');
        window.setTimeout(() => {
          if (model) model.expression('蛋包饭').catch(() => {});
        }, 6000);
      } catch (error) {
        console.error('[whale-pet]', error);
      }
    }

    if (isHidden()) {
      hideBoot();
    } else if (isSmall()) {
      setBoot('点我叫醒鲸鱼娘', 'idle');
    } else {
      setBoot('鲸鱼娘正在游过来…', 'loading');
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', ensureModel, { once: true });
      } else {
        ensureModel();
      }
    }
  })();
</script>

<style>
  .whale-pet {
    position: fixed;
    right: max(0.9rem, env(safe-area-inset-right));
    bottom: max(0.5rem, env(safe-area-inset-bottom));
    z-index: 45;
    width: 258px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  .whale-pet[data-ready='true'] {
    opacity: 1;
  }

  .whale-pet:not([data-ready='true']) .whale-pet-stage {
    pointer-events: none;
  }

  .whale-pet-stage {
    position: relative;
    width: 100%;
    height: 336px;
    pointer-events: auto;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .whale-pet-stage canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .whale-pet-hide {
    position: absolute;
    top: 0.3rem;
    right: 0.35rem;
    z-index: 2;
    width: 1.55rem;
    height: 1.55rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
    cursor: pointer;
    pointer-events: auto;
    opacity: 0.72;
    transition:
      opacity 0.2s ease,
      border-color 0.2s ease;
  }

  .whale-pet-hide:hover {
    opacity: 1;
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
  }

  .whale-pet-bubble {
    position: absolute;
    top: 0.55rem;
    left: 0.1rem;
    max-width: 178px;
    margin: 0;
    padding: 0.42rem 0.62rem;
    border: 1px solid var(--color-border);
    border-radius: 0.55rem;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    color: var(--color-text);
    font-size: 0.72rem;
    line-height: 1.45;
    box-shadow: 0 6px 18px rgb(0 0 0 / 18%);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    pointer-events: none;
  }

  .whale-pet-bubble[data-show='true'] {
    opacity: 1;
    transform: translateY(0);
  }

  .whale-pet-credit {
    margin: 0;
    padding-top: 0.15rem;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    line-height: 1.45;
    color: var(--color-muted);
    opacity: 0.72;
    pointer-events: auto;
  }

  .whale-pet-credit a {
    color: inherit;
    text-decoration: none;
  }

  .whale-pet-credit a:hover {
    color: var(--color-accent-strong);
  }

  .whale-pet-credit-short {
    display: none;
  }

  .whale-pet-credit span span {
    opacity: 0.8;
  }

  .whale-pet-boot {
    position: fixed;
    right: max(0.9rem, env(safe-area-inset-right));
    bottom: max(0.7rem, env(safe-area-inset-bottom));
    z-index: 46;
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    padding: 0.36rem 0.62rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    line-height: 1.3;
    box-shadow: 0 4px 14px rgb(0 0 0 / 14%);
    pointer-events: none;
  }

  .whale-pet-boot[hidden] {
    display: none !important;
  }

  .whale-pet-boot::before {
    content: '';
    flex: none;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 9999px;
    background: var(--color-accent);
    animation: whale-pulse 1.5s ease-in-out infinite;
  }

  .whale-pet-boot[data-mode='idle'],
  .whale-pet-boot[data-mode='error'] {
    pointer-events: auto;
    cursor: pointer;
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
  }

  .whale-pet-boot[data-mode='error']::before {
    animation: none;
    background: var(--color-accent);
  }

  @keyframes whale-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(0.8);
    }
    50% {
      opacity: 1;
      transform: scale(1.15);
    }
  }

  .whale-pet-return {
    display: none;
    position: fixed;
    right: max(0.9rem, env(safe-area-inset-right));
    bottom: max(0.7rem, env(safe-area-inset-bottom));
    z-index: 45;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 14px rgb(0 0 0 / 16%);
  }

  .whale-pet-return:hover {
    color: var(--color-accent-strong);
    border-color: var(--color-accent);
  }

  :global(html.whale-hidden) .whale-pet,
  :global(html.whale-hidden) .whale-pet-boot {
    display: none;
  }

  :global(html.whale-hidden) .whale-pet-return {
    display: grid;
    place-items: center;
  }

  @media (max-width: 640px) {
    .whale-pet {
      width: 176px;
    }

    .whale-pet-stage {
      height: 220px;
    }

    .whale-pet-bubble {
      display: none;
    }

    .whale-pet-credit {
      font-size: 0.52rem;
    }

    .whale-pet-credit-full {
      display: none;
    }

    .whale-pet-credit-short {
      display: inline;
    }

    .whale-pet-hide {
      width: 1.35rem;
      height: 1.35rem;
      font-size: 0.65rem;
    }
  }

  @media (max-width: 400px) {
    .whale-pet {
      width: 150px;
    }

    .whale-pet-stage {
      height: 192px;
    }
  }
</style>
