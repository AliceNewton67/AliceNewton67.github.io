---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// 使用 Content Layer API 的 getCollection（替代已废弃的旧用法）
// 生产构建时过滤 draft: true
const posts = (await getCollection('posts'))
  .filter((post) => import.meta.env.PROD ? !post.data.draft : true)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const siteTitle = 'Ecliptic Event';
const description = '面向系统编程与算法研究的个人技术博客';
const author = 'Alice';

// 首页 JSON-LD（WebSite）
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteTitle,
  description,
  author: { '@type': 'Person', name: author },
};
---

<BaseLayout
  title={siteTitle}
  description={description}
  :jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-6 py-14">
    <!-- 顶部品牌行 -->
    <header class="border-b border-(--color-border) pb-10">
      <div class="brand-row justify-between">
        <div class="brand-row">
          <span class="brand-dot" aria-hidden="true"></span>
          <span class="text-sm tracking-[0.2em] uppercase text-(--color-muted)">
            {siteTitle}
          </span>
        </div>
        <span class="font-mono text-xs text-(--color-muted)">
          est. {new Date().getFullYear()}
        </span>
      </div>

      <!-- Hero：学术杂志式大标题 -->
      <div class="mt-8">
        <h1 class="text-4xl md:text-5xl font-bold leading-[1.15] tracking-tight">
          <span class="text-(--color-accent-strong)">Notes on</span>
          <br />
          C++ · Algorithms · Systems
        </h1>
        <p class="mt-4 max-w-lg text-[0.98rem] leading-relaxed text-(--color-muted)">
          {description}
        </p>
        <p class="mt-5 font-mono text-xs text-(--color-muted)">
          by {author} — 零运行时 · 构建时渲染 · 写作即编译
        </p>
      </div>
    </header>

    <!-- 文章列表 -->
    <main id="main" class="mt-12">
      <h2 class="mb-6 inline-flex items-baseline gap-3 font-mono text-xs uppercase tracking-[0.18em] text-(--color-muted)">
        <span class="text-(--color-accent-strong)">●</span>
        文章列表
        <span class="text-(--color-muted)">({posts.length})</span>
      </h2>

      <ul class="space-y-6">
        {posts.map((post, i) => (
          <li>
            <a class="article-card" href={`/posts/${post.id}/`}>
              <div class="flex items-baseline justify-between gap-4">
                <time
                  datetime={post.data.date.toISOString()}
                  class="card-date card-meta"
                >
                  {post.data.date.toISOString().slice(0, 10)}
                </time>
                <span class="card-meta">Vol. {String(i + 1).padStart(2, '0')}</span>
              </div>

              <h3 class="mt-3 text-[1.28rem] font-bold leading-snug tracking-tight">
                {post.data.title}
              </h3>

              {post.data.description && (
                <p class="mt-2 line-clamp-3 text-[0.95rem] leading-relaxed text-(--color-muted)">
                  {post.data.description}
                </p>
              )}

              {post.data.tags.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <li class="tag-pill">{tag}</li>
                  ))}
                </ul>
              )}
            </a>
          </li>
        ))}
      </ul>
    </main>

    <!-- 页脚 -->
    <footer class="mt-16 border-t border-(--color-border) pt-6 text-center text-xs text-(--color-muted)">
      <p class="font-mono">© {new Date().getFullYear()} {author} · Powered by Astro · Zero JS in runtime</p>
    </footer>
  </div>
</BaseLayout>
