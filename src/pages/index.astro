---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { SECTIONS, sectionHref } from '../config/sections';

// 使用 Content Layer API 的 getCollection（替代已废弃的旧用法）
// 生产构建时过滤 draft: true
const allPosts = (await getCollection('posts'))
  .filter((post) => import.meta.env.PROD ? !post.data.draft : true)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 按分区聚合：空分区仍然渲染（未来写的游戏/数学会自己出现）
const grouped = SECTIONS.map((section) => ({
  section,
  posts: allPosts.filter((post) => post.data.section === section.key),
}));

const siteTitle = 'Ecliptic Event';
const description = '面向系统编程与算法研究的个人技术博客';
const author = 'Alice';

// 首页 JSON-LD（WebSite）
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteTitle,
  description,
  author: { '@type': 'Person', name: author },
};
---

<BaseLayout
  title={siteTitle}
  description={description}
  :jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-6 py-14">
    <!-- 顶部品牌行 -->
    <header class="border-b border-(--color-border) pb-10">
      <div class="brand-row justify-between">
        <div class="brand-row">
          <span class="brand-dot" aria-hidden="true"></span>
          <span class="text-sm tracking-[0.2em] uppercase text-(--color-muted)">
            {siteTitle}
          </span>
        </div>
        <span class="font-mono text-xs text-(--color-muted)">
          est. {new Date().getFullYear()}
        </span>
      </div>

      <!-- Hero：学术杂志式大标题 -->
      <div class="mt-8">
        <h1 class="text-4xl md:text-5xl font-bold leading-[1.15] tracking-tight">
          <span class="text-(--color-accent-strong)">Notes on</span>
          <br />
          C++ · Algorithms · Systems
        </h1>
        <p class="mt-4 max-w-lg text-[0.98rem] leading-relaxed text-(--color-muted)">
          {description}
        </p>
        <p class="mt-5 font-mono text-xs text-(--color-muted)">
          by {author} — 零运行时 · 构建时渲染 · 写作即编译
        </p>
      </div>
    </header>

    <!-- 分区索引 -->
    <nav
      class="mt-8 flex flex-wrap gap-2"
      aria-label="分区索引"
    >
      {grouped.map(({ section, posts }) => (
        <a
          href={`#${section.key}`}
          class="inline-flex items-center gap-2 rounded-md border border-(--color-border) px-3 py-1.5 text-xs text-(--color-muted) transition-colors hover:border-(--color-accent) hover:text-(--color-accent-strong)"
        >
          <span class="font-mono">{section.rune}</span>
          {section.label}
          <span class="font-mono text-[0.7rem] opacity-70">{posts.length}</span>
        </a>
      ))}
    </nav>

    <!-- 分区展示 -->
    <main id="main" class="mt-14">
      {grouped.map(({ section, posts }) => (
        <section id={section.key} class="section-block">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="inline-flex items-baseline gap-3 font-mono text-xs uppercase tracking-[0.18em] text-(--color-muted)">
              <span class="text-(--color-accent-strong)">{section.rune}</span>
              {section.label}
              <span class="text-(--color-muted)">({posts.length})</span>
            </h2>
            <a
              href={sectionHref(section.key)}
              class="font-mono text-[0.7rem] text-(--color-muted) transition-colors hover:text-(--color-accent-strong)"
            >
              查看全部 →
            </a>
          </div>
          <div class="section-head-divider mt-3" aria-hidden="true"></div>
          <p class="mt-3 text-[0.92rem] leading-relaxed text-(--color-muted)">
            {section.description}
          </p>

          {posts.length > 0 ? (
            <ul class="mt-6 space-y-6">
              {posts.map((post, i) => (
                <li>
                  <PostCard
                    post={post}
                    volume={`Vol. ${String(i + 1).padStart(2, '0')}`}
                  />
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-6 rounded-lg border border-dashed border-(--color-border) px-4 py-6 text-center font-mono text-xs text-(--color-muted)">
              暂无文章 — 这个分区还空着。
            </p>
          )}
        </section>
      ))}
    </main>

    <!-- 页脚 -->
    <footer class="mt-16 border-t border-(--color-border) pt-6 text-center text-xs text-(--color-muted)">
      <p class="font-mono">© {new Date().getFullYear()} {author} · Powered by Astro</p>
    </footer>
  </div>
</BaseLayout>
