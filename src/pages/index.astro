---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// 使用 Content Layer API 的 getCollection（替代已废弃的旧用法）
// 生产构建时过滤 draft: true
const posts = (await getCollection('posts'))
  .filter((post) => import.meta.env.PROD ? !post.data.draft : true)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const siteTitle = 'Ecliptic Event';
const description = '面向系统编程与算法研究的个人技术博客';

// 首页 JSON-LD（WebSite）
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteTitle,
  description,
};
---

<BaseLayout
  title={siteTitle}
  description={description}
  :jsonLd={jsonLd}
>
  <div class="mx-auto max-w-4xl px-6 py-12">
    <header class="mb-12 border-b border-(--color-border) pb-8">
      <h1 class="text-3xl font-bold tracking-tight text-(--color-accent-strong)">{siteTitle}</h1>
      <p class="mt-2 text-(--color-muted)">{description}</p>
    </header>

    <main id="main">
      <!-- 桌面导航（<details> 折叠菜单，零 JS） -->
      <aside class="mb-10">
        <details>
          <summary class="cursor-pointer select-none text-(--color-accent) font-medium">
            文章导航
          </summary>
          <ul class="mt-4 space-y-1">
            {posts.map((post) => (
              <li>
                <a href={`/posts/${post.id}/`} class="text-(--color-accent)">
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </aside>

      <h2 class="sr-only">文章列表</h2>
      <ul class="space-y-8">
        {posts.map((post) => (
          <li class="group">
            <article class="rounded-lg border border-(--color-border) bg-(--color-surface) p-6">
              <time
                datetime={post.data.date.toISOString()}
                class="text-sm text-(--color-muted)"
              >
                {post.data.date.toISOString().slice(0, 10)}
              </time>
              <h3 class="mt-1 text-xl font-semibold">
                <a
                  href={`/posts/${post.id}/`}
                  class="text-(--color-text) hover:text-(--color-accent-strong)"
                >
                  {post.data.title}
                </a>
              </h3>
              {post.data.description && (
                <p class="mt-2 text-(--color-muted)">{post.data.description}</p>
              )}
              {post.data.tags.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <li
                      class="rounded-full bg-(--color-surface-2) px-3 py-0.5 text-xs text-(--color-muted)"
                    >
                      #{tag}
                    </li>
                  ))}
                </ul>
              )}
            </article>
          </li>
        ))}
      </ul>
    </main>
  </div>
</BaseLayout>
