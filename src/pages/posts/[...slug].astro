---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSection, sectionHref } from '../../config/sections';

// 静态生成所有文章路径（SSG）
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => import.meta.env.PROD ? !data.draft : true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      date: Date;
      description?: string;
      tags: string[];
      section: string;
    };
    body: string;
    render: () => Promise<{ Content: any }>;
  };
}

const { post } = Astro.props;
const { Content } = await render(post);
const section = getSection(post.data.section);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  datePublished: post.data.date.toISOString(),
  description: post.data.description,
  author: {
    '@type': 'Person',
    name: 'Alice',
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description ?? post.data.title}
  :jsonLd={jsonLd}
  canonicalPath={`/posts/${post.id}/`}
>
  <div class="mx-auto max-w-4xl px-6 py-12">
    <nav class="mb-10 flex flex-wrap items-center gap-3">
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-md border border-(--color-border) px-3 py-1.5 font-mono text-xs text-(--color-muted) transition-colors hover:border-(--color-accent) hover:text-(--color-accent)"
      >
        ← 全部
      </a>
      {section && (
        <a
          href={sectionHref(section.key)}
          class="inline-flex items-center gap-2 rounded-md border border-(--color-border) px-3 py-1.5 font-mono text-xs text-(--color-muted) transition-colors hover:border-(--color-accent) hover:text-(--color-accent)"
        >
          {section.rune} {section.label}
        </a>
      )}
    </nav>

    <article>
      <header class="border-b border-(--color-border) pb-10">
        <div class="mb-3 flex items-center gap-3">
          <span class="tag-pill">{section ? section.label : 'Article'}</span>
          <time
            datetime={post.data.date.toISOString()}
            class="card-meta"
          >
            {post.data.date.toISOString().slice(0, 10)}
          </time>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold leading-[1.2] tracking-tight">
          {post.data.title}
        </h1>
        {post.data.description && (
          <p class="mt-4 max-w-2xl text-[0.98rem] leading-relaxed text-(--color-muted)">
            {post.data.description}
          </p>
        )}
        {post.data.tags.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <li class="tag-pill">{tag}</li>
            ))}
          </ul>
        )}
      </header>

      <div class="prose mt-10">
        <Content />
      </div>
    </article>

    <footer class="mt-16 flex flex-col items-center gap-2 border-t border-(--color-border) pt-8 text-center">
      <p class="text-sm text-(--color-muted)">
        如果在阅读中发现错误，欢迎反馈指正。
      </p>
      <a
        href="/"
        class="mt-1 inline-flex items-center gap-1 font-mono text-xs text-(--color-accent) hover:text-(--color-accent-strong)"
      >
        ← 回到文章列表
      </a>
      <p class="mt-2 font-mono text-[0.7rem] tracking-wider uppercase text-(--color-muted) opacity-70">
        Ecliptic Event
      </p>
    </footer>
  </div>
</BaseLayout>
